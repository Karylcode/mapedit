{
  "name": "mapedit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm prepare:cli && tsc -b && pnpm --filter @mapedit/web build",
    "prepare:cli": "node scripts/prepare-cli.mjs",
    "generate:authoring": "node scripts/generate-authoring.mjs",
    "typecheck": "pnpm prepare:cli && tsc -b --pretty false",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "lint": "eslint packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mapedit": "node packages/cli/dist/index.js",
    "dev:web": "pnpm --filter @mapedit/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.12.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0"
  }
}
